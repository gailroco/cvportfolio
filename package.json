{
  "homepage": "http://gailroco.github.io/cvportfolio",
  "name": "cvportfolio",
  "version": "1.0.0",
  "private": true,
  "description": "A simplified portfolio with Gatsby",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "start": "npm run develop",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "lint": "eslint .",
    "build": "gatsby build",
    "serve": "gatsby serve --prefix-paths",
    "clean": "gatsby clean",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\" && exit 1",
    "deploy": "gatsby build --prefix-paths && gh-pages -d public",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bootstrap": "^5.3.8",
    "gatsby": "^5.15.0",
    "gatsby-plugin-image": "^3.15.0",
    "gatsby-plugin-manifest": "^5.15.0",
    "gatsby-plugin-sass": "^6.15.0",
    "gatsby-plugin-sharp": "^5.15.0",
    "gatsby-plugin-sitemap": "^6.15.0",
    "gatsby-source-filesystem": "^5.15.0",
    "gatsby-transformer-remark": "^6.15.0",
    "gatsby-transformer-sharp": "^5.15.0",
    "nanoid": "^5.1.5",
    "postcss": "^8.5.18",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-scroll": "^1.9.0",
    "react-tilt": "^1.0.2",
    "sass": "^1.92.1",
    "sass-embedded": "^1.92.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "eslint": "^9.26.0",
    "eslint-plugin-react": "^7.34.1",
    "gh-pages": "^6.1.1",
    "globals": "^15.3.0",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "@babel/core": ">=7.29.7 <8.0.0",
    "@babel/helpers": ">=7.26.10 <8.0.0",
    "@babel/plugin-transform-modules-systemjs": ">=7.29.7 <8.0.0",
    "@babel/runtime": ">=7.26.10 <8.0.0",
    "base-x": ">=3.0.11",
    "brace-expansion": ">=1.1.18 <2.0.0",
    "cookie": ">=0.7.0 <1.0.0",
    "cross-spawn": ">=7.0.5",
    "eslint-plugin-react": {
      "minimatch": {
        ".": ">=10.2.6",
        "brace-expansion": ">=5.0.8"
      }
    },
    "@eslint/eslintrc": {
      "js-yaml": ">=4.3.1 <5.0.0"
    },
    "fast-uri": ">=3.1.5 <4.0.0",
    "file-type": ">=21.3.1 <22.0.0",
    "form-data": ">=4.0.6",
    "immutable": ">=3.8.3",
    "lodash": ">=4.18.0 <5.0.0",
    "micromatch": ">=4.0.8",
    "path-to-regexp": ">=0.1.13 <0.2.0",
    "resolve-url-loader": {
      "postcss": ">=8.5.10"
    },
    "serialize-javascript": ">=7.0.5 <8.0.0",
    "sharp": ">=0.35.0 <0.36.0",
    "shell-quote": ">=1.9.0",
    "tar-fs": ">=3.1.1",
    "tmp": ">=0.2.6",
    "uuid": ">=11.1.1 <12.0.0",
    "webpack": ">=5.105.0",
    "ws": ">=8.21.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gailroco/cvportfolio"
  },
  "bugs": {
    "url": "https://github.com/gailroco/cvportfolio/issues"
  },
  "lint-staged": {
    "*.+(js|jsx)": [
      "eslint --fix",
      "git add"
    ],
    "*.+(json|css|md)": [
      "prettier --write",
      "git add"
    ]
  }
}
